# Copie para .env (ou defina as variáveis no host) e ajuste os valores.
# Node 20.6+ pode carregar este arquivo com: node --env-file=.env server.mjs

PORT=8787
HOST=0.0.0.0

# Pastas de dados persistentes (catálogo, feed e capas).
DATA_DIR=./data

# Endereço público usado para montar as URLs de capa e do feed.
# Em produção use HTTPS, por exemplo: https://loja.exemplo.com
PUBLIC_BASE_URL=

# Recomendado em servidor público. O painel pede esta chave para editar.
ADMIN_TOKEN=

# Origens permitidas para chamadas de API (separadas por vírgula).
# Exemplo: https://antipobres.github.io,https://loja.exemplo.com
CORS_ORIGINS=

# Limite de download para cálculo de SHA-256 (bytes). Padrão: 20 GiB.
MAX_HASH_BYTES=21474836480

# Permite URLs HTTP em localhost/LAN para testes locais. Não use em produção.
ALLOW_PRIVATE_URLS=0

# IA opcional (qualquer provedor compatível com OpenAI).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
